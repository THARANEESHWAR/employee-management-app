{
	"_version": "1.84.0",
	"sap.app": {
		"id": "com.employee.employeelist",
		"type": "application",
		"i18n": {
			"bundleUrl": "i18n/i18n.properties",
			"supportedLocales": [
				"en"
			],
			"fallbackLocale": "en"
		},
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"dataSources": {
			"mainService": {
				"uri": "/odata/v4/employee/",
				"type": "OData",
				"settings": {
					"annotations": [],
					"odataVersion": "4.0"
				}
			}
		},
		"crossNavigation": {
			"inbounds": {
				"intent1": {
					"signature": {
						"parameters": {},
						"additionalParameters": "allowed"
					},
					"semanticObject": "Employee",
					"action": "manage",
					"title": "Employee Management",
					"subTitle": "Manage your employees",
					"icon": "sap-icon://employee"
				}
			}
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},
	"sap.fiori": {
		"registrationIds": [],
		"archeType": "transactional"
	},
	"sap.ui5": {
		"flexEnabled": true,
		"dependencies": {
			"minUI5Version": "1.136.0",
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.ushell": {},
				"sap.fe.templates": {}
			}
		},
		"contentDensities": {
			"compact": true,
			"cozy": true
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "com.employee.employeelist.i18n.i18n",
					"supportedLocales": [
						"en"
					],
					"fallbackLocale": "en"
				}
			},
			"": {
				"dataSource": "mainService",
				"preload": true,
				"settings": {
					"synchronizationMode": "None",
					"operationMode": "Server",
					"autoExpandSelect": true,
					"earlyRequests": true
				}
			}
		},
		"routing": {
			"config": {},
			"routes": [
				{
					"pattern": ":?query:",
					"name": "EmployeesList",
					"target": "EmployeesList"
				},
				{
					"pattern": "Employees({key}):?query:",
					"name": "EmployeesObjectPage",
					"target": "EmployeesObjectPage"
				}
			],
			"targets": {
				"EmployeesList": {
					"type": "Component",
					"id": "EmployeesList",
					"name": "sap.fe.templates.ListReport",
					"options": {
						"settings": {
							"entitySet": "Employees",
							"variantManagement": "Page",
							"initialLoad": true,
							"navigation": {
								"Employees": {
									"detail": {
										"route": "EmployeesObjectPage"
									}
								}
							},
							"controlConfiguration": {
								"@com.sap.vocabularies.UI.v1.LineItem": {
									"tableSettings": {
										"type": "ResponsiveTable",
										"selectionMode": "Multi",
										"enableExport": true,
										"creationMode": {
											"name": "NewPage",
											"createAtEnd": false
										}
									}
								}
							}
						}
					}
				},
				"EmployeesObjectPage": {
					"type": "Component",
					"id": "EmployeesObjectPage",
					"name": "sap.fe.templates.ObjectPage",
					"options": {
						"settings": {
							"entitySet": "Employees",
							"editableHeaderContent": false
						}
					}
				}
			}
		},
		"flexBundle": false
	}
}