{
  "name": "employee-app",
  "version": "1.0.0",
  "description": "Employee Management App",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@cap-js/sqlite": "^2.4.0",
    "@sap/cds": "^9",
    "express": "^4"
  },
  "devDependencies": {
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.13.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-employee-list": "cds watch --open com.employee.employeelist/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "cds": {
    "requires": {
      "auth": {
        "kind": "mocked",
        "users": {
          "admin": {
            "password": "admin@123",
            "roles": ["HRAdmin", "Manager"]
          },
          "manager": {
            "password": "manager@123",
            "roles": ["Manager"]
          },
          "employee": {
            "password": "employee@123",
            "roles": ["Employee"]
          }
        }
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/employee-list"
  ]
}
